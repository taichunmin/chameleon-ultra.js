{
  "author": "taichunmin <taichunmin@gmail.com>",
  "browser": "./dist/index.global.js",
  "description": "A JavaScript SDK for ChameleonUltra using Web Bluetooth, Web Serial and SerialPort.",
  "homepage": "https://taichunmin.idv.tw/chameleon-ultra.js/",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "name": "chameleon-ultra.js",
  "packageManager": "yarn@1.22.22",
  "type": "commonjs",
  "version": "0.4.13",
  "bugs": {
    "url": "https://github.com/taichunmin/chameleon-ultra.js/issues"
  },
  "contributors": [
    {
      "email": "taichunmin@gmail.com",
      "name": "Chunmin Tai",
      "url": "https://taichunmin.idv.tw"
    }
  ],
  "dependencies": {
    "@taichunmin/buffer": "^0.13.19",
    "@taichunmin/crc": "^0.0.22",
    "debug": "^4.4.3",
    "jszip": "^3.10.2",
    "lodash-es": "^4.18.1",
    "serialport": "^13.0.0",
    "web-serial-polyfill": "^1.0.15",
    "webbluetooth": "^7.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/debug": "^4.1.13",
    "@types/finalhandler": "^1.2.4",
    "@types/json5": "^2.2.0",
    "@types/livereload": "^0.9.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/pug": "^2.0.10",
    "@types/serve-static": "^2.2.0",
    "@types/uglify-js": "^3.17.5",
    "@types/web-bluetooth": "^0.0.22",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.7",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "eslint": "^10",
    "eslint-plugin-pug": "^1.2.7",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-glob": "^3.3.3",
    "finalhandler": "^2.1.1",
    "globals": "^17.14.0",
    "html-minifier": "^5.2.0",
    "json5": "^2.2.3",
    "jstransformer-sass": "^1.0.0",
    "livereload": "^0.10.3",
    "mkdirp": "^3.0.1",
    "neostandard": "^0.14.1",
    "node-watch": "^0.7.4",
    "nodemon": "^3.1.14",
    "publint": "^0.3.25",
    "pug": "^3.0.4",
    "rimraf": "^6.1.4",
    "serve-static": "^2.2.1",
    "supports-color": "^11.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "type-fest": "^6.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-ga": "^1.1.1",
    "typedoc-plugin-llms-txt": "^0.1.2",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^6",
    "uglify-js": "^3.19.3",
    "utility-types": "^3.11.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.ts"
      },
      "script": "./dist/index.global.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": {
        "import": "./dist/*.d.mts",
        "require": "./dist/*.d.ts"
      },
      "script": "./dist/*.global.js",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "keywords": [
    "browser",
    "chameleon-ultra",
    "chrome",
    "COM",
    "mifare classic",
    "nfc",
    "RFID",
    "serial port",
    "serial",
    "serialport",
    "UART",
    "web bluetooth",
    "web serial",
    "web-bluetooth-api",
    "web-serial-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taichunmin/chameleon-ultra.js.git"
  },
  "resolutions": {
    "**/typescript": "^6",
    "**/jstransformer-scss": "^2.0.0"
  },
  "scripts": {
    "build": "yarn build:js && yarn build:docs && yarn build:pug && yarn build:sitemap",
    "build:docs": "typedoc",
    "build:js": "tsdown",
    "build:pug": "tsx ./pug/build.ts",
    "build:sitemap": "tsx ./build-utils/typedoc.ts && tsx ./build-utils/sitemap.ts",
    "dev": "DEBUG_COLORS=1 concurrently --names \"DOC,HTTPS,PUG,TS\" -c \"bgGray,bgGreen,bgGray,bgBlue,bgYellow\" \"yarn dev:docs\" \"yarn dev:https\" \"yarn dev:pug\" \"yarn dev:js\"",
    "dev:docs": "nodemon --watch src --watch documents --ext ts,md --exec \"yarn build:docs && yarn build:sitemap\"",
    "dev:https": "tsx ./build-utils/https.ts",
    "dev:js": "nodemon --watch public --ext cjs,js,mjs,ts --exec \"yarn build:js\"",
    "dev:pug": "nodemon --watch pug --ext pug --exec \"yarn build:pug && yarn build:sitemap\"",
    "lint": "yarn lint:ci --fix",
    "lint:ci": "eslint",
    "mkcert": "mkdirp ./mkcert && mkcert -key-file ./mkcert/key.pem -cert-file ./mkcert/cert.pem -ecdsa localhost",
    "publish:test": "npm pack --dry-run",
    "test": "vitest -r ./src --testTimeout 180000",
    "test:ci": "yarn test --run --coverage"
  }
}
